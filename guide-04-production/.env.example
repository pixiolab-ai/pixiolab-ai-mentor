# Copy to .env and fill in. Never commit the real file.
# Load it into your shell before running anything:  set -a; . ./.env; set +a

# --- Model providers (Chapter 00, Feature 01) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # fallback provider and embeddings
LLM_MODEL=claude-sonnet-5-5      # set to current model IDs
JUDGE_MODEL=claude-opus-5-5      # Feature 03: not the model under test
FALLBACK_MODEL=                  # "<your-model-id>" from a second provider; empty = no fallback
EMBED_MODEL=                     # "<your-embedding-model-id>" (Feature 06)
EMBED_DIM=1024                   # must match vector(N) in db/schema.sql

# --- Local services (docker compose up -d) ---
DATABASE_URL=postgresql://app:app@localhost/app      # local development only
REDIS_URL=redis://localhost:6379/0
# Feature 06: searches connect as the read-only app_rag role. Leave this
# commented out to search as the table owner (row-level security is bypassed).
# RAG_DATABASE_URL=postgresql://app_rag:<password>@localhost/app

# --- Cost tracking and budget (Feature 02) ---
BUSINESS_TZ=America/Los_Angeles
DAILY_BUDGET_USD=50
TRACK_USAGE=1                    # CI sets 0 so eval runs don't write usage rows
SLACK_BOT_TOKEN=                 # a bot token with chat:write

# --- Scheduled jobs and paging (Feature 04) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
HEARTBEAT_URL_DAILY_SIGNUPS=     # optional: an outside heartbeat monitor's ping URL

# --- Queue and rate limits (Feature 05) ---
MAX_QUEUE_DEPTH=500
LLM_RPM_LIMIT=400                # about 80% of your account's limits
LLM_ITPM_LIMIT=200000

# --- Identity provider (Feature 06) ---
OIDC_ISSUER=                     # exactly as your IdP writes it, e.g. https://<your-idp>/
OIDC_AUDIENCE=                   # the identifier of this API
OIDC_JWKS_URL=                   # your IdP's JWKS endpoint
OIDC_GROUPS_CLAIM=groups
